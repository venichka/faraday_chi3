 RowBox[{"sol1", " ", "=", " ", 
  RowBox[{
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ap", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}], "-", "\[Kappa]"}], 
           "2"], " ", 
