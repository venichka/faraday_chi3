Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Clear", " ", "and", " ", "define"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Dfun", "[", 
      RowBox[{
      "t_", ",", "a_", ",", "b_", ",", "c_", ",", "\[Tau]0_", ",", 
       "\[Omega]j_", ",", 
       RowBox[{"D0_", ":", "1"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z", ",", "term1", ",", "term2"}], "}"}], ",", 
       RowBox[{
        RowBox[{"z", "=", 
         RowBox[{"-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "t"}], "/", "\[Tau]0"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"term1", "=", 
         RowBox[{
          RowBox[{"Gamma", "[", "c", "]"}], " ", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"b", "-", "a"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Gamma", "[", "b", "]"}], " ", 
             RowBox[{"Gamma", "[", 
              RowBox[{"c", "-", "a"}], "]"}]}], ")"}]}], "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "a"}], " ", 
            RowBox[{"t", "/", "\[Tau]0"}]}], "]"}], "*", 
          RowBox[{"Hypergeometric2F1", "[", 
           RowBox[{"a", ",", 
            RowBox[{"a", "+", "1", "-", "c"}], ",", 
            RowBox[{"a", "+", "1", "-", "b"}], ",", "z"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"term2", "=", 
         RowBox[{
          RowBox[{"Gamma", "[", "c", "]"}], " ", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"a", "-", "b"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Gamma", "[", "a", "]"}], " ", 
             RowBox[{"Gamma", "[", 
              RowBox[{"c", "-", "b"}], "]"}]}], ")"}]}], "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "b"}], " ", 
            RowBox[{"t", "/", "\[Tau]0"}]}], "]"}], "*", 
          RowBox[{"Hypergeometric2F1", "[", 
           RowBox[{"b", ",", 
            RowBox[{"b", "+", "1", "-", "c"}], ",", 
            RowBox[{"b", "+", "1", "-", "a"}], ",", "z"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"D0", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "\[Omega]j", " ", "t"}], "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"term1", "+", "term2"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Example"}]}], " ", "parameters", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"avoid", " ", "poles", " ", "of", " ", "Gamma"}], ")"}], 
       "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pars", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "->", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{"\"\<b\>\"", "->", 
        RowBox[{"3", "/", "4"}]}], ",", 
       RowBox[{"\"\<c\>\"", "->", 
        RowBox[{"7", "/", "6"}]}], ",", 
       RowBox[{"\"\<\[Tau]0\>\"", "->", "1.0"}], ",", 
       RowBox[{"\"\<\[Omega]j\>\"", "->", 
        RowBox[{"2", " ", "Pi"}]}], ",", 
       RowBox[{"\"\<D0\>\"", "->", "1"}]}], "|>"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Plot", " ", "Re"}], ",", "Im", ",", 
     RowBox[{"and", "|", "D", "|", 
      RowBox[{
       RowBox[{"over", " ", "t"}], ">", "0"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Re", "@", 
         RowBox[{"Dfun", "[", 
          RowBox[{"t", ",", 
           RowBox[{"pars", "[", "\"\<a\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<b\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<c\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<\[Tau]0\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<\[Omega]j\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<D0\>\"", "]"}]}], "]"}]}], ",", 
        RowBox[{"Im", "@", 
         RowBox[{"Dfun", "[", 
          RowBox[{"t", ",", 
           RowBox[{"pars", "[", "\"\<a\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<b\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<c\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<\[Tau]0\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<\[Omega]j\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<D0\>\"", "]"}]}], "]"}]}], ",", 
        RowBox[{"Abs", "@", 
         RowBox[{"Dfun", "[", 
          RowBox[{"t", ",", 
           RowBox[{"pars", "[", "\"\<a\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<b\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<c\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<\[Tau]0\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<\[Omega]j\>\"", "]"}], ",", 
           RowBox[{"pars", "[", "\"\<D0\>\"", "]"}]}], "]"}]}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Re D(t)\>\"", ",", "\"\<Im D(t)\>\"", 
        ",", "\"\<|D(t)|\>\""}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "None"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
     RowBox[{"ImageSize", "->", "Large"}]}], "]"}], "\n"}]}]], "Input",
