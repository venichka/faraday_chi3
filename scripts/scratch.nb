Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"eP", " ", "==", " ", 
       FractionBox[
        RowBox[{"ex", "+", 
         RowBox[{"\[ImaginaryI]", " ", "ey"}]}], 
        SqrtBox["2"]]}], ",", 
      RowBox[{"eM", " ", "==", " ", 
       FractionBox[
        RowBox[{"ex", "-", 
         RowBox[{"\[ImaginaryI]", " ", "ey"}]}], 
        SqrtBox["2"]]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"ex", ",", "ey"}], "}"}]}], "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.971537895195695*^9, 3.971537966973155*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"51c762f6-a95b-4d99-81fe-45fd60fd3dc6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"ex", "\[Rule]", 
     FractionBox[
      RowBox[{"eM", "+", "eP"}], 
      SqrtBox["2"]]}], ",", 
    RowBox[{"ey", "\[Rule]", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"(", 
